# Shared room storage (required for Vercel deployments)
#
# Without these, rooms live in a single server's memory: perfect for local
# development, but two players on different devices will not reliably see the
# same match once deployed.
#
# Create a free Redis database at https://upstash.com, then copy the REST URL
# and REST token here (or add them in the Vercel project settings).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel KV / Upstash integration names are also supported:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
